# Ensure canonical LF line endings across all platforms
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Explicitly declare binary files to prevent line ending translation
*.png binary
*.pdf binary
*.gif binary
